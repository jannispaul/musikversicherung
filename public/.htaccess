# Astro builds with build.format:"file", so pages are emitted as flat files
# (anfrage.html, wissen/instrumentenversicherung-fur-klaviere.html, …) while
# internal links are extensionless (/anfrage, /wissen/…). Map an extensionless
# request to the matching .html file so those links resolve.
#
# The single guarded rule only rewrites when "<request>.html" actually exists,
# so real assets (/images/…, /_astro/…, /reviews.json) pass through untouched.
# It also makes /wissen serve wissen.html rather than the wissen/ directory.
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# /wissen has both wissen.html and a wissen/ directory (from wissen/*.astro).
# Without this, mod_dir 301-redirects /wissen -> /wissen/, which serves the
# index-less directory (404) instead of wissen.html. Turning off the auto-slash
# lets the rewrite above resolve /wissen to wissen.html. No directory on the
# site is browsed for a listing, so losing the trailing-slash redirect is safe.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>
