# Astro builds with build.format:"file", so pages are emitted as flat files
# (anfrage.html, wissen/instrumentenversicherung-fur-klaviere.html, …) while
# internal links are extensionless (/anfrage, /wissen/…). Map an extensionless
# request to the matching .html file so those links resolve.
#
# The single guarded rule only rewrites when "<request>.html" actually exists,
# so real assets (/images/…, /_astro/…, /reviews.json) pass through untouched.
# It also makes /wissen serve wissen.html rather than the wissen/ directory.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Enforce the site's trailingSlash:"never" convention: redirect /wissen/ to
  # /wissen (root excluded) so there's one canonical URL and the rule below can
  # resolve it. This also fixes /wissen/, whose trailing slash otherwise maps to
  # the index-less wissen/ directory (404) instead of wissen.html.
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Extensionless URL -> flat .html file (/anfrage -> anfrage.html), only when
  # that file exists so real assets pass through untouched.
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# /wissen has both wissen.html and a wissen/ directory (from wissen/*.astro).
# Without this, mod_dir 301-redirects /wissen -> /wissen/, which serves the
# index-less directory (404) instead of wissen.html. Turning off the auto-slash
# lets the rewrite above resolve /wissen to wissen.html. No directory on the
# site is browsed for a listing, so losing the trailing-slash redirect is safe.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# --- Compression -----------------------------------------------------------
# Compress text-based responses over the wire. Brotli is preferred when the
# host provides it (mod_brotli), with gzip (mod_deflate) as the fallback. Both
# blocks are guarded so the file stays valid if a module is missing. Already-
# compressed binaries (avif/webp/woff2/pdf/lottie) are deliberately excluded.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/manifest+json
</IfModule>

# --- Caching ---------------------------------------------------------------
# Astro fingerprints hashed assets under /_astro/ (content hash in the name), so
# they can be cached forever and immutably. Fonts/images are versioned by path
# and get a long TTL. HTML is revalidated so content edits go live immediately.
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf|otf|lottie)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
