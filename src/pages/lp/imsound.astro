---
import Layout from "../../layouts/Layout.astro";
import Reviews from "../../components/Reviews.astro";
import mainHtml from "../../partials/lp/imsound.html?raw";
import pageCss from "../../partials/lp/imsound.css?raw";

const seo = {
  "title": "Musik-Equipment versichern ab 6,25 €/Monat | I’M SOUND",
  "description": "Die I’M SOUND Equipmentversicherung schützt elektronische Instrumente und Musikequipment weltweit – auch im Proberaum und Auto. Bis 20.000 € online abschließen.",
  "canonical": "https://musikversicherung.com/lp/imsound",
  "lang": "de",
  "ogTitle": "Musik-Equipment versichern ab 6,25 €/Monat | I’M SOUND",
  "ogDescription": "Die I’M SOUND Equipmentversicherung schützt elektronische Instrumente und Musikequipment weltweit – auch im Proberaum und Auto. Bis 20.000 € online abschließen.",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "Musik-Equipment versichern ab 6,25 €/Monat | I’M SOUND",
  "twitterDescription": "Die I’M SOUND Equipmentversicherung schützt elektronische Instrumente und Musikequipment weltweit – auch im Proberaum und Auto. Bis 20.000 € online abschließen.",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image",
  // noindex,follow: /lp/imsound clones the SINFONIMA LP pattern and reuses the
  // same copy, so it reads as thin/duplicate content and is kept out of the
  // index (owner ruling 2026-09-05). It stays live + crawlable as a campaign/ad
  // landing page (follow), and is excluded from the sitemap in astro.config.
  // The self-canonical stays: this is the I'M SOUND (equipment) product, a
  // different product from SINFONIMA, so it must NOT cross-canonical to
  // /lp/sinfonima the way /lp/berufsmusiker does.
  "robots": "noindex,follow"
};
---

<Layout {...seo}>
  <style is:global is:inline set:html={pageCss} slot="head"></style>
  <Reviews html={mainHtml} limit={15} />
  <script>
      import "../../scripts/accordion.js";
  </script>
</Layout>
