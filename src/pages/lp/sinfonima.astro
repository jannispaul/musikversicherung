---
import Layout from "../../layouts/Layout.astro";
import Reviews from "../../components/Reviews.astro";
import mainHtml from "../../partials/lp/sinfonima.html?raw";
import pageCss from "../../partials/lp/sinfonima.css?raw";
import { productLd } from "../../data/structured-data";

const seo = {
  "title": "Versicherung für klassische Instrumente | Mannheimer Sinfonima",
  "description": "Mit der Sinfonima Instrumentenversicherung sind deine Instrumente weltweit optimal geschützt – ob im Alltag, auf Reisen oder bei Konzerten.",
  "canonical": "https://musikversicherung.com/lp/sinfonima",
  "lang": "de",
  "ogTitle": "Versicherung für klassische Instrumente | Mannheimer Sinfonima",
  "ogDescription": "Mit der Sinfonima Instrumentenversicherung sind deine Instrumente weltweit optimal geschützt – ob im Alltag, auf Reisen oder bei Konzerten.",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "Versicherung für klassische Instrumente | Mannheimer Sinfonima",
  "twitterDescription": "Mit der Sinfonima Instrumentenversicherung sind deine Instrumente weltweit optimal geschützt – ob im Alltag, auf Reisen oder bei Konzerten.",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image",
  "robots": "index,follow",
  // Insurance offering as a Product. The page shows the live rating/count and
  // the two tariff prices ("4,69 € im Monat" / "6,25 € monatlich"), so both the
  // aggregateRating and the offers are backed by visible content, same as the
  // homepage. Organization + WebSite come site-wide from BaseHead.
  "jsonld": [productLd({ includeOffers: true })]
};
---

<Layout {...seo}>
  <style is:global is:inline set:html={pageCss} slot="head"></style>
  <Reviews html={mainHtml} limit={15} />
  <script>
      import "../../scripts/accordion.js";
  </script>
</Layout>
