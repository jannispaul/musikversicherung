---
import Layout from "../layouts/Layout.astro";
import mainHtml from "../partials/kontakt.html?raw";
import { breadcrumbLd } from "../data/structured-data";

const seo = {
  "jsonld": [
    breadcrumbLd([
      { name: "Home", item: "https://musikversicherung.com" },
      { name: "Kontakt" },
    ]),
  ],
  "title": "Kontakt & Beratung – Musikversicherung.com",
  "description": "Fragen oder Beratungsbedarf? Kontaktiere Musikversicherung.com für eine individuelle Auskunft zur Versicherung deiner Instrumente und deines Equipments.",
  "canonical": "https://musikversicherung.com/kontakt",
  "lang": "de",
  "ogTitle": "Kontakt & Beratung – Musikversicherung.com",
  "ogDescription": "Fragen oder Beratungsbedarf? Kontaktiere Musikversicherung.com für eine individuelle Auskunft zur Versicherung deiner Instrumente und deines Equipments.",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "Kontakt & Beratung – Musikversicherung.com",
  "twitterDescription": "Fragen oder Beratungsbedarf? Kontaktiere Musikversicherung.com für eine individuelle Auskunft zur Versicherung deiner Instrumente und deines Equipments.",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image"
};
---

<Layout {...seo}>
  <Fragment set:html={mainHtml} />
</Layout>
