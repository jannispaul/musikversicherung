---
import Layout from "../layouts/Layout.astro";
import mainHtml from "../partials/reviews.html?raw";
import {
  renderReviewItems,
  reviewsJsonLd,
  reviewCount,
  averageDisplay,
} from "../data/reviews";

// Bake the reviews into the markup at build time (previously fetched client-side).
const renderedHtml = mainHtml
  .replace(
    /<div class="reviews_item hide">[\s\S]*?Name um Date<\/div><\/div>/,
    renderReviewItems(),
  )
  .replace(
    /(<span data-name="average-rating"[^>]*>)[^<]*(<\/span>)/,
    `$1${averageDisplay}$2`,
  )
  .replace(
    /(<span data-name="review-count"[^>]*>)[^<]*(<\/span>)/,
    `$1${reviewCount}$2`,
  );

const seo = {
  jsonld: [reviewsJsonLd()],
  "title": "Berwertungen und Erfahrungen – Musikversicherung.com",
  "description": "Die positiven Bewertungen sprechen für sich. Über 1000 Reviews sagen: Einfach, schnell und freundlich. Top Service und eine einzigartige Instrumentenversicherung",
  "canonical": "https://musikversicherung.com/reviews",
  "lang": "de",
  "ogTitle": "Berwertungen und Erfahrungen – Musikversicherung.com",
  "ogDescription": "Die positiven Bewertungen sprechen für sich. Über 1000 Reviews sagen: Einfach, schnell und freundlich. Top Service und eine einzigartige Instrumentenversicherung",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "Berwertungen und Erfahrungen – Musikversicherung.com",
  "twitterDescription": "Die positiven Bewertungen sprechen für sich. Über 1000 Reviews sagen: Einfach, schnell und freundlich. Top Service und eine einzigartige Instrumentenversicherung",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image"
};
---

<Layout {...seo}>
  <Fragment set:html={renderedHtml} />
</Layout>
