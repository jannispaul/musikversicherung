---
import Layout from "../layouts/Layout.astro";
import Reviews from "../components/Reviews.astro";
import mainHtml from "../partials/reviews.html?raw";
import { productLd, breadcrumbLd } from "../data/structured-data";

const seo = {
  jsonld: [
    // No `includeOffers`: /reviews shows no price, and schema may not assert
    // what the page does not display (wiki/aeo-rules.md §4).
    productLd({ includeReviews: true }),
    breadcrumbLd([
      { name: "Home", item: "https://musikversicherung.com" },
      { name: "Bewertungen" },
    ]),
  ],
  "title": "Bewertungen und Erfahrungen – Musikversicherung.com",
  "description": "Über 1000 Bewertungen sprechen für sich: einfach, schnell und freundlich. Top-Service und eine einzigartige Instrumentenversicherung.",
  "canonical": "https://musikversicherung.com/reviews",
  "lang": "de",
  "ogTitle": "Bewertungen und Erfahrungen – Musikversicherung.com",
  "ogDescription": "Über 1000 Bewertungen sprechen für sich: einfach, schnell und freundlich. Top-Service und eine einzigartige Instrumentenversicherung.",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "Bewertungen und Erfahrungen – Musikversicherung.com",
  "twitterDescription": "Über 1000 Bewertungen sprechen für sich: einfach, schnell und freundlich. Top-Service und eine einzigartige Instrumentenversicherung.",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image"
};
---

<Layout {...seo}>
  <Reviews html={mainHtml} />
</Layout>
