---
import Layout from "../layouts/Layout.astro";
import mainHtml from "../partials/faqs.html?raw";
import pageCss from "../partials/faqs.css?raw";
import { breadcrumbLd } from "../data/structured-data";

// NB: the FAQ Q&A markup already ships as schema.org FAQPage microdata inside
// faqs.html, so only the breadcrumb is added here (no duplicate FAQPage).
const seo = {
  "jsonld": [
    breadcrumbLd([
      { name: "Home", item: "https://musikversicherung.com" },
      { name: "FAQ" },
    ]),
  ],
  "title": "FAQ zur Instrumentenversicherung – Musikversicherung.com",
  "description": "Alle Fragen zum Thema Instrumentenversicherung schnell und einfach vom Experten beantwortet. In den FAQs findest du die Antworten.",
  "canonical": "https://musikversicherung.com/faqs",
  "lang": "de",
  "ogTitle": "FAQ zur Instrumentenversicherung – Musikversicherung.com",
  "ogDescription": "Alle Fragen zum Thema Instrumentenversicherung schnell und einfach vom Experten beantwortet. In den FAQs findest du die Antworten.",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "FAQ zur Instrumentenversicherung – Musikversicherung.com",
  "twitterDescription": "Alle Fragen zum Thema Instrumentenversicherung schnell und einfach vom Experten beantwortet. In den FAQs findest du die Antworten.",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image"
};
---

<Layout {...seo}>
  <style is:global is:inline set:html={pageCss} slot="head"></style>
  <Fragment set:html={mainHtml} />
  <script>
      import "../scripts/accordion.js";
  </script>
</Layout>
