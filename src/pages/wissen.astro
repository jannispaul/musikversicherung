---
import Layout from "../layouts/Layout.astro";
import mainHtml from "../partials/wissen.html?raw";
import { collectionPageLd, listedPages, breadcrumbLd } from "../data/structured-data";

const seo = {
  "jsonld": [
    collectionPageLd({
      name: "Wissen zur Instrumentenversicherung",
      description:
        "Alle wichtigen Detailinformationen zur Instrumentenversicherung und Absicherung von Equipment vom Experten für dich aufbereitet.",
      url: "https://musikversicherung.com/wissen",
      lists: listedPages(mainHtml),
    }),
    breadcrumbLd([
      { name: "Home", item: "https://musikversicherung.com" },
      { name: "Wissen" },
    ]),
  ],
  "title": "Wissen zur Instrumentenversicherung – Musikversicherung.com",
  "description": "Alle wichtigen Detailinformationen zur Instrumentenversicherung und Absicherung von Equipment vom Experten für dich aufbereitet.",
  "canonical": "https://musikversicherung.com/wissen",
  "lang": "de",
  "ogTitle": "Wissen zur Instrumentenversicherung – Musikversicherung.com",
  "ogDescription": "Alle wichtigen Detailinformationen zur Instrumentenversicherung und Absicherung von Equipment vom Experten für dich aufbereitet.",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "Wissen zur Instrumentenversicherung – Musikversicherung.com",
  "twitterDescription": "Alle wichtigen Detailinformationen zur Instrumentenversicherung und Absicherung von Equipment vom Experten für dich aufbereitet.",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image"
};
---

<Layout {...seo}>
  <Fragment set:html={mainHtml} />
</Layout>
