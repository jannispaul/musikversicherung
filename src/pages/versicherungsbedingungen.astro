  "lang": "de",
  "ogTitle": "Versicherungsbedingungen – Musikversicherung.com",
  "ogDescription": "Hier findest du das Kleingedruckte. Die Versicherungsbedingungen der Mannheimer in voller Länge.",
  "ogImage": "https://musikversicherung.com/images/og-image.jpg",
  "ogType": "website",
  "twitterTitle": "Versicherungsbedingungen – Musikversicherung.com",
  "twitterDescription": "Hier findest du das Kleingedruckte. Die Versicherungsbedingungen der Mannheimer in voller Länge.",
  "twitterImage": "https://musikversicherung.com/images/og-image.jpg",
  "twitterCard": "summary_large_image"
};
---

<Layout {...seo}>
  <Fragment set:html={mainHtml} />
</Layout>
