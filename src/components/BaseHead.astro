---
import "../styles/main.css";
import { SITE } from "../data/site";
import { organizationLd } from "../data/structured-data";

interface Props {
  title: string;
  description?: string | null;
  canonical?: string | null;
  ogTitle?: string | null;
  ogDescription?: string | null;
  ogImage?: string | null;
  ogType?: string | null;
  twitterTitle?: string | null;
  twitterDescription?: string | null;
  twitterImage?: string | null;
  twitterCard?: string | null;
  robots?: string | null;
  /** Raw JSON-LD strings, injected verbatim into <script type="application/ld+json">. */
  jsonld?: string[];
}

const {
  title,
  description,
  canonical = new URL(Astro.url.pathname.replace(/\/$/, "") || "/", SITE.url).href,
  ogTitle,
  ogDescription,
  ogImage,
  ogType = "website",
  twitterTitle,
  twitterDescription,
  twitterImage,
  twitterCard = "summary_large_image",
  robots,
  jsonld = [],
} = Astro.props;

const ASSET = "/assets/63f2893134fa326a6838c84d";
const resolvedOgImage = ogImage ?? SITE.defaultOgImage;
const resolvedTwitterImage = twitterImage ?? resolvedOgImage;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
{description && <meta name="description" content={description} />}
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={canonical} />

{/* Open Graph */}
<meta property="og:title" content={ogTitle ?? title} />
{
  (ogDescription ?? description) && (
    <meta property="og:description" content={ogDescription ?? description!} />
  )
}
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content={SITE.name} />
{canonical && <meta property="og:url" content={canonical} />}

{/* Twitter */}
<meta property="twitter:title" content={twitterTitle ?? ogTitle ?? title} />
{
  (twitterDescription ?? ogDescription ?? description) && (
    <meta
      property="twitter:description"
      content={twitterDescription ?? ogDescription ?? description!}
    />
  )
}
<meta property="twitter:image" content={resolvedTwitterImage} />
<meta name="twitter:card" content={twitterCard} />

{/* Favicons */}
<link rel="shortcut icon" type="image/x-icon" href={`${ASSET}/63f3e1b701f05c48543fdca2_favicon-32x32.png`} />
<link rel="apple-touch-icon" href={`${ASSET}/63f3e2ae508ba1ff759ac321_touchicon.png`} />

{/* Webflow feature-detection: adds .w-mod-js / .w-mod-touch to <html> for CSS hooks */}
<script is:inline>
  !(function (o, c) {
    var n = c.documentElement,
      t = " w-mod-";
    (n.className += t + "js"),
      ("ontouchstart" in o || (o.DocumentTouch && c instanceof DocumentTouch)) &&
        (n.className += t + "touch");
  })(window, document);
</script>

{/* Site-wide structured data: InsuranceAgency + WebSite */}
<script type="application/ld+json" is:inline set:html={organizationLd()} />

{/* Page-specific structured data */}
{jsonld.map((data) => <script type="application/ld+json" is:inline set:html={data} />)}

{/* Speculation Rules: prerender same-origin links for snappier navigation */}
<script type="speculationrules" is:inline>
  {
    "prerender": [{
      "where": {
        "and": [
          { "href_matches": "/*" },
          { "not": {"selector_matches": ".do-not-prerender"}},
          { "not": {"selector_matches": "[rel=nofollow]"}}
        ]
      },
      "eagerness": "moderate"
    }]
  }
</script>

{/* --- Analytics & consent (site-wide, third-party) --- */}
{/*
  GA4 and Meta (Pixel + Conversions API) are loaded server-side by Cloudflare
  Zaraz, which Cloudflare auto-injects once the domain is proxied — there is no
  tag-loader here on purpose (the old client-side GTM container + Google Consent
  Mode gtag defaults were removed as part of the Zaraz migration).

  Umami stays client-side: it's self-hosted and cookieless, so it runs without
  consent. Cookiebot remains the consent UI; the bridge below relays its choices
  to Zaraz's consent purposes so Zaraz tools only fire with the right consent.
*/}
<script defer src="https://umami.paulwicke.com/script.js" data-website-id="0b06d9ab-7a86-4977-9e81-3f1931717e3f" is:inline></script>
<script is:inline>
  window.addEventListener("CookiebotOnDialogInit", function () {
    if (Cookiebot.getDomainUrlParam("CookiebotScan") === "true")
      Cookiebot.setOutOfRegion();
  });
</script>
<script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="88d955d0-3b6f-4434-a22c-3286e17ac641" data-blockingmode="auto" type="text/javascript" is:inline></script>

{/*
  Cookiebot → Zaraz consent bridge.
  Relays Cookiebot's statistics/marketing choices to Zaraz's consent purposes.
  Zaraz assigns each purpose a random ID, so we resolve the ID by matching the
  purpose NAME ("analytics" / "marketing") — set those names in Zaraz → Consent.
  Re-syncs on every Cookiebot change and regardless of Zaraz/Cookiebot load order.
*/}
<script is:inline>
  (function () {
    function syncConsentToZaraz() {
      if (!window.zaraz || !window.zaraz.consent) return;
      if (!window.Cookiebot || !window.Cookiebot.consent) return;
      var wanted = {
        analytics: !!window.Cookiebot.consent.statistics,
        marketing: !!window.Cookiebot.consent.marketing,
      };
      var purposes = window.zaraz.consent.purposes || {};
      var payload = {};
      Object.keys(purposes).forEach(function (id) {
        var n = purposes[id] && purposes[id].name;
        // name may be a plain string or a localized object like { en: "analytics" }
        var name = typeof n === "string" ? n : n && (n.en || n[Object.keys(n)[0]]);
        var key = String(name || "").toLowerCase();
        if (Object.prototype.hasOwnProperty.call(wanted, key)) payload[id] = wanted[key];
      });
      if (Object.keys(payload).length) window.zaraz.consent.set(payload);
    }
    window.addEventListener("CookiebotOnConsentReady", syncConsentToZaraz);
    window.addEventListener("CookiebotOnAccept", syncConsentToZaraz);
    window.addEventListener("CookiebotOnDecline", syncConsentToZaraz);
    document.addEventListener("zarazConsentAPIReady", syncConsentToZaraz);
  })();
</script>
